  },
  "metric_conventions": {
    "log_loss": "mean natural log loss; lower is better",
    "brier": "mean squared probability error; lower is better",
    "accuracy": "threshold above 0.5, with half credit at exactly 0.5; higher is better",
    "incumbent_minus_external_log_loss": "Alcaraz minus the external system, paired on identical matches; negative favours Alcaraz",
    "uncertainty": "stationary calendar-week block bootstrap on each block's own Monday grid; primary mean block 8 weeks, 4 and 13 as sensitivities"
  },
